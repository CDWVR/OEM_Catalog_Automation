# Copy to .env and fill in your keys (never commit .env)

# Required for Layer 3 extraction (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary web search (Layer 3) — https://docs.exa.ai/reference/search-api-guide-for-coding-agents
EXA_API_KEY=your_exa_api_key_here
EXA_SEARCH_TYPE=deep
EXA_NUM_RESULTS=10

# auto = cache -> crawl DB -> Exa -> DDGS fallback
# exa | discovered_only | ddgs
SEARCH_PROVIDER=auto

# Cache search URL lists in SQLite (hours)
SEARCH_CACHE_TTL_HOURS=168

# DDGS fallback only (ignored when Exa returns enough URLs)
SEARCH_MAX_OEM_QUERIES=3
SEARCH_MAX_OPEN_QUERIES=1

# Auto-discover OEM hubs/domains when missing from seed_data (query + crawl)
OEM_AUTO_DISCOVER=true
OEM_MIN_HUBS=1
# Crawl BFS: max link hops from hub seeds (1–20). Override per run with --depth
CRAWL_MAX_DEPTH=4
# Used when discover --crawl runs without --depth (falls back to CRAWL_MAX_DEPTH)
OEM_DISCOVER_CRAWL_DEPTH=4

# Layer 2: prescreen / extract limits; gzip page snippets on crawl (chars)
LAYER2_MAX_PRESCREEN=40
LAYER2_MAX_EXTRACT=5
CRAWL_SNIPPET_MAX_CHARS=12000
MATRIX_SCRAPE_MAX_CHARS=48000

# Accept results with lifecycle fields below 0.55 if confidence >= this
PARTIAL_CONFIDENCE_THRESHOLD=0.42
PARTIAL_MIN_FIELDS=1
